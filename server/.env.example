# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (database "nestmates"), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nestmates?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWTs (HS256). At least 32 characters; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Origin of the frontend: allowed by CORS and used in password reset links.
FRONTEND_ORIGIN=http://localhost:5173

# SMTP provider (e.g. Brevo) for password reset emails. Port 465 uses implicit TLS,
# other ports must support STARTTLS. Leave SMTP_HOST empty to disable email: password
# reset requests then fail with SERVICE_UNAVAILABLE.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Number of reverse proxies in front of the server (1 on Render), so rate limiting sees client IPs.
TRUST_PROXY=0

# Rate limiting of the /api/auth routes, per client IP.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# info, warn, error or silent
LOG_LEVEL=info

# Google Cloud Translation API key. Keep this on the server. Leave it empty to
# run the application without translation; a translate request then fails.
GOOGLE_TRANSLATE_API_KEY=your_google_translation_api_key_here
TRANSLATION_TIMEOUT_MS=1500
